{% extends 'base.html.twig' %}

{% block title %}{{ login ? "Connexion" : "Inscription"}}{% endblock %}

{% block body %}


<div class="container">
    <div class="form_auth">
        {% if error is not empty %}
        
        <div class="error">
            {{error}}
        </div>
        {% endif %}

        {% if info is not empty %}
            <div class="info">  
                {{ info }}
            </div>  
        {% endif %}
        


        {% if login %}
            <h1>Connexion</h1>

            <form method="post" action="{{ path('app_login') }}">
                <label for="email">Adresse e-mail</label>
                <input type="email" id="email" name="email" placeholder="votre@email.com" {{ mail ? 'value=' ~ mail ~ ''}} required>

                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="password" placeholder="Mot de passe" required>

                <div class="auth-actions">
                    <button type="submit" name="action" value="login" class="login">Connexion</button>
                    <a href="/resetpassword" class="forgot-password">Mot de passe oublié</a>
                    <br>
                    <a class="btn" href="/register">Vous avez pas de compte ?</a>
                </div>
            </form>

        {% elseif not login %}

            <h1>Creation de compte</h1>

            <form method="post" action="/register">
                <label for="name">Nom</label>
                <input type="text" id="name" name="nom" placeholder="Nom" {{ nom ? 'value=' ~ nom ~ ''}} required>

                <label for="firstname">Prenom</label>
                <input type="text" id="firstname" name="prenom" placeholder="Prenom" {{ prenom ? 'value=' ~ prenom ~ ''}} required>

                <label for="email">Adresse e-mail</label>
                <input type="email" id="email" name="email" placeholder="votre@email.com" {{ mail ? 'value=' ~ mail ~ ''}} required>

                <label for="email_confirm">Confirmation de l'adresse e-mail</label>
                <input type="email" id="email_confirm" name="email_confirm" placeholder="votre@email.com" {{ mail_check ? 'value=' ~ mail_check ~ ''}} required>

                <label for="birthdate">Date de naissance</label>
                <input type="date" id="birthdate" name="birthdate" value={{ birthdate ? birthdate : "2000-01-01" }} required>

                <label for="social_security">Numéro de sécurité sociale</label>
                <input type="text" id="social_security" name="social_security" placeholder="1234567890123" {{ social_security ? 'value=' ~ social_security ~ ''}} required>

                <label for="fighter_name">Pseudo de combattant</label>
                <input type="text" id="fighter_name" name="fighter_name" placeholder="SachaDu93"  {{ fighter_name ? 'value=' ~ fighter_name ~ ''}} require>

                <label for="pokemon">Sélection du Pokémon</label>
                <select id="pokemon" name="pokemon" required>
                    <option value="">-- Choisir un Pokémon --</option>
                    <option value="bulbizarre" {{ (pokemon ==  "bulbizarre") ? 'selected'}} >Bulbizarre</option>
                    <option value="salameche" {{ (pokemon == "salameche" ) ? 'selected' }} >Salamèche</option>
                    <option value="carapuce" {{ (pokemon ==  "carapuce") ? 'selected' }} >Carapuce</option>
                </select>

                <label for="password">Mot de passe</label>
                <input type="password" id="password" name="password" placeholder="Mot de passe" required>

                <label for="password_confirm">Confirmation du mot de passe</label>
                <input type="password" id="password_confirm" name="password_confirm" placeholder="Mot de passe" required>

                <div class="auth-actions">
                    <button type="submit" name="action" value="register" class="register">S'inscrire</button>
                    <a class="btn" href="/login">Vous avez un compte ?</a>
                </div>
            </form>

        {% else %}
            <div class="error-message">
                <p>Une erreur est survenue. Veuillez réessayer.</p>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}


{% block stylesheets %}
    {{ parent() }}  {# garde le app.scss global #}
    {{ encore_entry_link_tags('auth') }}
{% endblock %}
